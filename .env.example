# Optional local database path. Defaults to .data/admin.sqlite
ADMIN_DB_PATH=.data/admin.sqlite
# Optional API port. Defaults to 3102
PORT=3102

# Production: credentials are provided by a root-only server environment file.
# NODE_ENV=production
# ADMIN_SOURCE=postgres
# ADMIN_ORIGIN=https://effective.omfreight.vip
# ADMIN_TENANT=szzhhq
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt$... (generate with hashPassword)
# ADMIN_SESSION_SECRET=<random base64url secret>
# DATABASE_URL=postgresql://freight_admin_api:<password>@127.0.0.1:5432/freight_times
